{
  "description": "Enforces the methodology in projects with .claude/dev-workflow.json, and checks the project's setup when a session starts",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook-session-start.sh"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook-bash.sh"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook-workflow-edit.sh"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*[Gg]it[Hh]ub.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook-github-mcp.sh"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
