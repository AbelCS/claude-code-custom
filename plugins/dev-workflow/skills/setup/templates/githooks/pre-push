#!/bin/sh
# Keeps pushes off the default branch, and runs the check on what's being pushed. Git
# runs it from the top of the work tree as: pre-push <remote name> <remote url>, with a
# "<local ref> <local sha> <remote ref> <remote sha>" line per ref on stdin.

hook_dir=$(dirname "$0")
if [ ! -r "$hook_dir/dw-lib.sh" ]; then
  printf 'pre-push: %s/dw-lib.sh is missing: run the setup skill to restore it\n' "$hook_dir" >&2
  exit 1
fi
# shellcheck source-path=SCRIPTDIR source=dw-lib.sh
. "$hook_dir/dw-lib.sh"

blocked=0
block() {
  printf 'pre-push: %s\n' "$*" >&2
  blocked=1
}

env_broken() {
  printf 'pre-push: could not load %s/dev-workflow.env: run the setup skill to create it again\n' "$hook_dir" >&2
  exit 1
}

# A value from the caller's environment isn't the project's setting. Unset rather than
# empty, so that a file that leaves a setting out doesn't read as having none.
unset DW_DEFAULT_BRANCH DW_CHECK
dw_load_env || env_broken
if [ -z "${DW_DEFAULT_BRANCH:-}" ] || [ -z "${DW_CHECK+set}" ]; then
  env_broken
fi

refs=$(cat)
head=$(git rev-parse -q --verify 'HEAD^{commit}')

to_default=0
publishes=0
while IFS= read -r line; do
  [ -n "$line" ] || continue

  # From the end, because a local ref can be an expression holding spaces.
  fields=${line% *}
  remote_ref=${fields##* }
  fields=${fields% *}
  local_sha=${fields##* }
  local_ref=${fields% *}

  if [ "$remote_ref" = "refs/heads/$DW_DEFAULT_BRANCH" ]; then
    to_default=1
  fi

  # An all-zero name, in either hash format, is a deletion, which publishes nothing.
  case $local_sha in
    *[!0]*) ;;
    *) continue ;;
  esac
  publishes=1

  # The check runs on the checkout, so anything else would go out unchecked. An annotated
  # tag has its own name, so what's compared is the commit under it.
  commit=$(git rev-parse -q --verify "$local_sha^{commit}")
  if [ -z "$commit" ] || [ "$commit" != "$head" ]; then
    case $local_ref in
      refs/heads/*) fix="git switch ${local_ref#refs/heads/}" ;;
      *) fix="git switch --detach $local_sha" ;;
    esac
    block "$remote_ref would get $local_ref, which isn't what's checked out, so the check wouldn't run on it: run $fix, then push again"
  fi
done <<REFS
$refs
REFS

# A new repo's first push finds no branches on the remote.
if [ "$to_default" -eq 1 ]; then
  if ! remote_branches=$(git ls-remote --heads -- "$2" </dev/null); then
    block "could not list the remote's branches, so this can't be told apart from a direct push to $DW_DEFAULT_BRANCH"
  elif [ -n "$remote_branches" ]; then
    block "don't push directly to $DW_DEFAULT_BRANCH: open a pull request"
  fi
fi

[ "$blocked" -eq 0 ] || exit 1

# Nothing but deletions, or nothing at all when everything is up to date.
[ "$publishes" -eq 1 ] || exit 0

if [ -z "$DW_CHECK" ]; then
  echo 'pre-push: no check command is configured: set commands.check in .claude/dev-workflow.json and run the setup skill' >&2
  exit 1
fi

# Read before the check, which may leave files of its own. A git failure counts as
# changes, because then nothing says the tree is clean.
uncommitted=$(git status --porcelain --untracked-files=normal) || uncommitted=unknown

sh -c "$DW_CHECK" </dev/null >&2
check_status=$?

if [ -n "$uncommitted" ]; then
  echo "pre-push: warning: the check ran on uncommitted changes, which this push doesn't include" >&2
fi
if [ "$check_status" -ne 0 ]; then
  printf 'pre-push: the check failed: %s\n' "$DW_CHECK" >&2
  exit 1
fi
